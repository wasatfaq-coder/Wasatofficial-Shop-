rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Администратор: верифицированный Google-аккаунт владельца
    // или пользователь, для которого вручную создан документ /admins/{uid}
    // (создаётся только через Firebase Console / Admin SDK).
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'gunh83975@gmail.com'
          && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Поле картинки баннера: нет поля или картинка data: (не ссылка — её открыл бы браузер каждого посетителя)
    function isBannerPicture(data, field) {
      return !(field in data)
        || (data[field] is string && data[field].matches('^data:image/(jpeg|png|webp|gif);base64,.*'));
    }

    // Изменены только перечисленные поля существующего документа
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Себестоимость живёт в закрытой product_costs: в товар её не добавить и не поменять, старое значение — только удалить
    function keepsCostPriceOut() {
      return !('costPrice' in request.resource.data)
        || request.resource.data.costPrice == resource.data.get('costPrice', null);
    }

    // settings/server.serverOrdersEnabled: заказы оформляет Cloud Function placeOrder
    // (Admin SDK, правила не применяются). Клиентам запрещено создавать заказы,
    // списывать остатки и менять счётчики промокодов напрямую.
    function serverOrdersEnabled() {
      let path = /databases/$(database)/documents/settings/server;
      return exists(path) && get(path).data.get('serverOrdersEnabled', false) == true;
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Каталог и витрина: читают все, меняет только администратор
    // ------------------------------------------------------------------

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(productId) && !('costPrice' in request.resource.data);
      allow delete: if isAdmin() && isValidId(productId);
      // Пока заказы не оформляются на сервере, покупатели списывают остатки — только своим заказом.
      // Остальные поля (в том числе старые отзывы внутри товара) — только администратор.
      allow update: if (isAdmin() && keepsCostPriceOut())
        || (!serverOrdersEnabled()
          && onlyChanges(['skus', 'inStock', 'lastStockMovement'])
          && isOrderStockDeduction(productId))
        || (onlyChanges(['skus', 'inStock', 'lastStockMovement'])
          && isOrderStockReturn(productId));
    }

    // Возврат на склад при отмене заказа покупателем (returnOrderLineStock в firebaseSync.ts, «Доработки 3»):
    // в одной транзакции с записью журнала «{заказ}_{строка}_return», которая создаётся один раз на строку и равна
    // списанию этой строки (isOrderStockReturnMovement). Меняется только остаток варианта строки, вверх ровно на
    // запись. «В продаже» включается, только если вариант был распродан: снятый с витрины товар, у которого
    // остаток был, остаётся снятым (кроме случая, когда кончился именно этот вариант — проверить все варианты
    // правило не может). Работает и при серверных заказах: placeOrder пишет записи списания с теми же id.
    function isOrderStockReturn(productId) {
      let data = request.resource.data;
      let movementId = data.get('lastStockMovement', '');
      let movementPath = /databases/$(database)/documents/stock_movements/$(movementId);
      return movementId is string && movementId.matches('^[A-Za-z0-9-]{1,40}_[0-9]{1,2}_return$')
        && !exists(movementPath) && existsAfter(movementPath)
        && getAfter(movementPath).data.changeQuantity > 0
        && isSkuDeductedBy(productId, resource.data.skus, data.skus, getAfter(movementPath).data)
        && (data.inStock == resource.data.get('inStock', true)
          || (data.inStock == true && resource.data.skus[getAfter(movementPath).data.skuIndex].stock == 0));
    }

    // Списание остатка заказом из браузера (deductOrderLineStock в firebaseSync.ts, аудит 02.10, находка 1):
    // в одной транзакции с записью журнала stock_movements по строке сохранённого заказа. Запись журнала создаётся
    // один раз на строку, поэтому и списать по строке можно один раз. Меняется ровно один вариант — тот, что
    // в строке заказа, — и только его остаток, только вниз и ровно на количество записи журнала. Артикулы,
    // штрихкоды, названия и другие варианты не меняются. «В продаже» снимается, только если вариант кончился.
    // Части списка до и после варианта сравниваются целиком (по одному выражению), поэтому проверка укладывается
    // в лимит Firestore (1000 выражений на запрос) при любом числе вариантов. Поддельный заказ по-прежнему может
    // списать товар (его видно в «Заказах»): это закрывают серверные заказы.
    function isOrderStockDeduction(productId) {
      let data = request.resource.data;
      let movementId = data.get('lastStockMovement', '');
      let movementPath = /databases/$(database)/documents/stock_movements/$(movementId);
      return movementId is string && movementId.matches('^[A-Za-z0-9-]{1,40}_[0-9]{1,2}$')
        && !exists(movementPath) && existsAfter(movementPath)
        && isSkuDeductedBy(productId, resource.data.skus, data.skus, getAfter(movementPath).data)
        && (data.inStock == resource.data.get('inStock', true)
          || (data.inStock == false && data.skus[getAfter(movementPath).data.skuIndex].stock == 0));
    }

    function isSkuDeductedBy(productId, before, after, movement) {
      let i = movement.skuIndex;
      let line = get(/databases/$(database)/documents/orders/$(movement.orderId)).data.items[movement.lineIndex];
      return movement.productId == productId
        && before is list && after is list && after.size() == before.size()
        && i is int && i >= 0 && i < before.size()
        && (i == 0 || after[0:i] == before[0:i])
        && (i == before.size() - 1 || after[i + 1:after.size()] == before[i + 1:before.size()])
        && after[i].diff(before[i]).affectedKeys().hasOnly(['stock'])
        && after[i].stock is number && after[i].stock >= 0
        && after[i].stock == before[i].stock + movement.changeQuantity
        && sameName(before[i].get('color', ''), line.get('selectedColor', ''))
        && sameName(before[i].get('size', ''), line.get('selectedSize', ''));
    }

    // Цвет и размер строки заказа и варианта сравниваются почти как в браузере (inventory.ts): без пробелов по краям
    // и без учёта регистра латиницы. lower() в правилах кириллицу не меняет: «черный» и «Черный» здесь разные.
    // На деле цвет строки берётся из цветов того же товара и совпадает с вариантом буква в букву
    function sameName(a, b) {
      return a is string && b is string && a.trim().lower() == b.trim().lower();
    }

    // Полные фото товара — отдельными документами (этап 6 без Storage, находка 18): в товаре лёгкие превью для карточек,
    // страница товара читает фото по id из product.photoIds. Пишет администратор
    match /product_photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(photoId)
        && (request.resource == null
          || (request.resource.data.keys().hasOnly(['productId', 'data'])
            && request.resource.data.productId is string
            && request.resource.data.data is string
            && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')));
    }

    // Лёгкий индекс каталога и миниатюры карточек (docs/catalog-scale-plan.md, этап 2): выводятся из товаров, пишет
    // сессия администратора, читает любой посетитель. Индекс — части p0, p1, … со сжатыми строками товаров
    match /catalog_index/{partId} {
      allow read: if true;
      allow write: if isAdmin() && partId.matches('^p[0-9]{1,3}$')
        && (request.resource == null
          || (request.resource.data.keys().hasOnly(['format', 'part', 'parts', 'hash', 'entries', 'updatedAt'])
            && request.resource.data.entries is bytes
            && request.resource.data.part is int && request.resource.data.parts is int
            && request.resource.data.hash is string && request.resource.data.hash.size() <= 64));
    }

    match /product_thumbs/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId)
        && (request.resource == null
          || (request.resource.data.keys().hasOnly(['productId', 'key', 'data'])
            && request.resource.data.productId == productId
            && request.resource.data.key is string && request.resource.data.key.size() <= 200
            && request.resource.data.data is string && request.resource.data.data.size() <= 100000
            && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*')));
    }

    // Себестоимость товаров: товар читает любой посетитель, поэтому она отдельно и только для администратора
    match /product_costs/{productId} {
      // Админка подписана на всю коллекцию: условие на id документа не дало бы прочитать её списком
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(productId);
    }

    // ------------------------------------------------------------------
    // Отзывы: reviews/{productId}_{uid} — один отзыв покупателя на товар,
    // менять может только автор, удалять — автор или администратор.
    // «Полезно»: review_votes/{reviewId}_{uid} — один голос от человека.
    // ------------------------------------------------------------------

    // Вход через Google (не анонимный гость чата)
    function isCustomer() {
      return isSignedIn()
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }

    function isOptionalText(data, field, maxLength) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLength);
    }

    // Имя автора отзыва и диалога чата не выдаёт себя за магазин: «Wasat Shop (официально)», «Администратор»,
    // «Служба поддержки» (аудит 02.10, находка 31). (?i) в RE2 сравнивает и кириллицу без учёта регистра
    function isHonestName(name) {
      return !name.matches('(?i).*(официальн|служба (поддержки|заботы)|поддержка магазина|(^|[^а-яёa-z])(администратор|админ|модератор|admin|support|official)([^а-яёa-z]|$)).*');
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasOnly(['id', 'productId', 'uid', 'authorName', 'rating', 'comment', 'pros', 'cons',
          'sizePurchased', 'colorPurchased', 'date', 'createdAt'])
        && data.id == reviewId
        && data.uid == request.auth.uid
        && data.productId is string
        && reviewId == data.productId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/products/$(data.productId))
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 60
        && isHonestName(data.authorName)
        && data.date is string && data.date.size() <= 40
        && data.createdAt is string && data.createdAt.size() <= 40
        && isOptionalText(data, 'pros', 500)
        && isOptionalText(data, 'cons', 500)
        && isOptionalText(data, 'sizePurchased', 40)
        && isOptionalText(data, 'colorPurchased', 60);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isCustomer() && isValidReview(request.resource.data, reviewId);
      allow update: if isCustomer()
        && resource.data.uid == request.auth.uid
        && isValidReview(request.resource.data, reviewId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /review_votes/{voteId} {
      allow read: if true;
      allow create: if isCustomer()
        && request.resource.data.keys().hasOnly(['reviewId', 'productId', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reviewId is string
        && request.resource.data.productId is string
        && voteId == request.resource.data.reviewId + '_' + request.auth.uid
        // только к существующему отзыву: голоса скачивает каждый посетитель (аудит 02.10, находка 16)
        && exists(/databases/$(database)/documents/reviews/$(request.resource.data.reviewId))
        // Не за свой отзыв (его id заканчивается на uid автора)
        && !request.resource.data.reviewId.matches('.*_' + request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /promos/{promoId} {
      allow read: if true;
      allow create, delete: if isAdmin() && isValidId(promoId);
      // Пока заказы оформляет браузер, покупатель увеличивает только счётчик использований (аудит 02.10, находка 2):
      // ровно на 1, не выше лимита кода и только вместе с отметкой promo_uses/{заказ} в том же пакете — по одной на
      // заказ с этим кодом. Выручку и комиссию партнёра браузер не пишет: комиссия считается из оплаченных
      // и полученных заказов (src/utils/partnerCommission.ts).
      allow update: if isAdmin()
        || (!serverOrdersEnabled()
          && onlyChanges(['usedCount', 'lastOrderId'])
          && request.resource.data.get('usedCount', 0) == resource.data.get('usedCount', 0) + 1
          && withinUsageLimit()
          && request.resource.data.lastOrderId is string
          && request.resource.data.lastOrderId.matches('^[A-Za-z0-9-]{1,40}$')
          && !exists(/databases/$(database)/documents/promo_uses/$(request.resource.data.lastOrderId))
          && existsAfter(/databases/$(database)/documents/promo_uses/$(request.resource.data.lastOrderId)));
    }

    // Лимит использований: без лимита (нет поля, 0 или null) — не ограничено
    function withinUsageLimit() {
      let usageLimit = resource.data.get('usageLimit', 0);
      return !(usageLimit is number) || usageLimit <= 0 || request.resource.data.usedCount <= usageLimit;
    }

    // Отметка «промокод использован заказом»: одна на заказ, только если в заказе этот код, и только вместе
    // с ростом счётчика промокода в том же пакете (recordPromoUsageInFirestore). Читает администратор.
    match /promo_uses/{orderId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isOrderPromoUse(orderId);
      allow update, delete: if isAdmin() && isValidId(orderId);
    }

    function isOrderPromoUse(orderId) {
      let data = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let promoPath = /databases/$(database)/documents/promos/$(data.promoId);
      return !serverOrdersEnabled()
        && orderId.matches('^[A-Za-z0-9-]{1,40}$')
        && data.keys().hasOnly(['orderId', 'promoId', 'createdAt'])
        && data.orderId == orderId
        && data.promoId is string && isValidId(data.promoId)
        && data.createdAt is string && data.createdAt.size() <= 40
        && exists(orderPath)
        // код «сжигает» только владелец заказа (находка 43): поддельный заказ без входа больше не записать
        && isSignedIn()
        && get(orderPath).data.get('customerUid', '') == request.auth.uid
        && get(orderPath).data.get('promoCode', '') is string
        && get(orderPath).data.get('promoCode', '').size() > 0
        && get(orderPath).data.promoCode.upper() == get(promoPath).data.code.upper()
        && getAfter(promoPath).data.get('lastOrderId', '') == orderId;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(bannerId);
    }

    // Картинки баннера (docs/catalog-scale-plan.md, этап 5): только картинки data:, баннер хранит их хэш (imageKey)
    match /banner_images/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(bannerId)
        && (request.resource == null
          || (request.resource.data.keys().hasOnly(['bannerId', 'image', 'mobileImage', 'desktopImage'])
            && request.resource.data.bannerId == bannerId
            && isBannerPicture(request.resource.data, 'image')
            && isBannerPicture(request.resource.data, 'mobileImage')
            && isBannerPicture(request.resource.data, 'desktopImage')));
    }

    match /settings/{settingId} {
      // шаблоны быстрых ответов поддержки — рабочие тексты сотрудников (аудит 02.10, находка 49 / тест B2)
      allow read: if settingId != 'quick_phrases' || isAdmin();
      allow write: if isAdmin() && isValidId(settingId);
    }

    match /delivery_methods/{methodId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(methodId);
    }

    match /pickup_points/{pointId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(pointId);
    }

    // Шаблоны реквизитов оплаты («Доработки 5»): только администратор. Покупатель видит реквизиты,
    // применённые к его заказу (поле paymentDetails), а не всю библиотеку
    match /payment_templates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(templateId);
    }

    // ------------------------------------------------------------------
    // Заказы: оформить может любой (включая гостей), читать —
    // владелец (по customerUid) или администратор, менять — администратор
    // ------------------------------------------------------------------

    // Заказ из браузера (completeOrderLocally в App.tsx): только его поля, контакты и тексты разумной длины,
    // не больше 30 строк, суммы в разумных границах. Строки поштучно не проверяются: даже 3 сравнения на строку
    // не укладываются в лимит 1000 выражений на 20+ строках. Поддельные количество и цена строки не трогают склад
    // и журнал (списание сверяется со строкой и только уменьшает остаток), а ссылку на фото из строки экраны не
    // показывают (orderLineImage). Цены строк сверяет placeOrder (серверные заказы, этап 5).
    function isClientOrderShape() {
      let data = request.resource.data;
      return data.keys().hasOnly(['id', 'createdAt', 'date', 'items', 'status', 'totalPrice', 'deliveryAddress',
          'deliveryMethod', 'customerName', 'customerPhone', 'customerEmail', 'customerUid', 'paymentMethod',
          'paymentStatus', 'deliveryFee', 'discountAmount', 'promoCode', 'estimatedDelivery', 'historySteps',
          'deliveryStages', 'customerLastName', 'customerFirstName', 'customerMiddleName', 'deliveryAddressParts', 'deliveryKind', 'statusLog'])
        && data.items.size() <= 30
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 40
        && data.deliveryAddress is string && data.deliveryAddress.size() <= 500
        && data.deliveryMethod is string && data.deliveryMethod.size() <= 100
        && data.paymentMethod is string && data.paymentMethod.size() <= 100
        && isOptionalText(data, 'customerEmail', 120)
        // Фамилия, имя, отчество и части адреса (src/shared/personName.ts) — для карточек с копированием в админке
        && isOptionalText(data, 'customerLastName', 60)
        && isOptionalText(data, 'customerFirstName', 60)
        && isOptionalText(data, 'customerMiddleName', 60)
        && (!('deliveryAddressParts' in data) || (data.deliveryAddressParts is map && data.deliveryAddressParts.size() <= 11))
        && isOptionalText(data, 'createdAt', 40)
        && isOptionalText(data, 'date', 40)
        && isOptionalText(data, 'promoCode', 40)
        && isOptionalText(data, 'estimatedDelivery', 80)
        && data.totalPrice <= 10000000
        && (!('deliveryFee' in data) || (data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 100000))
        && (!('discountAmount' in data)
          || (data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= 10000000))

        && (!('historySteps' in data) || (data.historySteps is list && data.historySteps.size() <= 20))
        && (!('deliveryStages' in data) || (data.deliveryStages is list && data.deliveryStages.size() <= 20))
        // тип доставки и первая запись истории («Доработки 4»)
        && (!('deliveryKind' in data) || data.deliveryKind in ['carrier', 'courier', 'pickup'])
        && (!('statusLog' in data) || (data.statusLog is list && data.statusLog.size() <= 1));
    }

    // Строки заказа из браузера (toOrderLineProduct, без фото): проверка развёрнута на 30 строк — циклов в правилах нет
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerUid == request.auth.uid);

      allow create: if isAdmin() || (
        !serverOrdersEnabled()
        && isValidId(orderId)
        // номер заказа показывается в админке и отчетах: только буквы, цифры и дефис
        && orderId.matches('^[A-Za-z0-9-]{1,40}$')
        && request.resource.data.id == orderId
        && request.resource.data.status == 'accepted'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice >= 0
        && request.resource.data.get('isCancelled', false) == false
        // «Оплачен» ставит только администратор: сайт денег не принимает
        && request.resource.data.get('paymentStatus', 'pending') in ['pending', 'paid_on_delivery']
        // Заказ — только под входом (Google или анонимный вход гостя) и со своим uid, вместе с отметкой частоты
        // order_rate/{uid} в том же пакете: не чаще раза в 30 с с одного входа (аудит 02.10, этап 5 без Blaze;
        // анонимных входов Firebase даёт не больше 100 в час с одного адреса)
        && isSignedIn()
        && request.resource.data.get('customerUid', null) == request.auth.uid
        && getAfter(/databases/$(database)/documents/order_rate/$(request.auth.uid)).data.orderId == orderId
        && isClientOrderShape()
      );

      allow update: if isAdmin() || isCustomerOrderCancel() || isCustomerStockReturnedMark()
        || isCustomerReceiptConfirm() || isCustomerReceiptSubmit(orderId) || isGuestOrderHandover();
      allow delete: if isAdmin();
    }

    // Гость вошёл через Google — его заказы и переписка переходят в аккаунт (аудит 02.10, находка 26). Согласны обе
    // стороны в этом браузере: анонимный вход гостя пишет guest_links/{гость} = { accountUid }, аккаунт —
    // account_guests/{аккаунт}_{гость}. Без второй половины посторонний не «подкинет» заказы чужому аккаунту.
    match /guest_links/{guestUid} {
      allow read: if isSignedIn() && request.auth.uid == guestUid;
      allow create, update: if isAnonymousSelf(guestUid)
        && request.resource.data.keys().hasOnly(['accountUid'])
        && request.resource.data.accountUid is string
        && request.resource.data.accountUid.matches('^[A-Za-z0-9-]{1,128}$')
        && request.resource.data.accountUid != guestUid;
      allow delete: if isAdmin();
    }

    match /account_guests/{linkId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.accountUid == request.auth.uid);
      allow create: if isSignedIn()
        && signInProvider() != 'anonymous'
        && request.resource.data.keys().hasOnly(['accountUid', 'guestUid'])
        && request.resource.data.accountUid == request.auth.uid
        && request.resource.data.guestUid is string
        && request.resource.data.guestUid.matches('^[A-Za-z0-9-]{1,128}$')
        && linkId == request.auth.uid + '_' + request.resource.data.guestUid;
      allow delete: if isAdmin();
    }

    function signInProvider() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '');
    }

    function isAnonymousSelf(uid) {
      return isSignedIn() && request.auth.uid == uid && signInProvider() == 'anonymous';
    }

    // Аккаунт accountUid принял гостя guestUid (обе половины связи на месте)
    function isLinkedAccount(guestUid, accountUid) {
      let link = get(/databases/$(database)/documents/guest_links/$(guestUid));
      return accountUid is string
        && link != null && link.data.accountUid == accountUid
        && exists(/databases/$(database)/documents/account_guests/$(accountUid + '_' + guestUid));
    }

    // Гость передаёт свой заказ своему аккаунту: меняется только владелец
    function isGuestOrderHandover() {
      return isAnonymousSelf(resource.data.get('customerUid', ''))
        && onlyChanges(['customerUid'])
        && isLinkedAccount(request.auth.uid, request.resource.data.customerUid);
    }

    // Отметка частоты заказов: одна на вход, обновляется только вместе с новым заказом этого входа и не чаще раза в 30 с
    match /order_rate/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastOrderAt', 'orderId'])
        && request.resource.data.lastOrderAt == request.time
        && request.resource.data.orderId is string
        && request.resource.data.orderId.matches('^[A-Za-z0-9-]{1,40}$')
        && (resource == null || request.time > resource.data.lastOrderAt + duration.value(30, 's'))
        && !exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerUid == uid;
      allow delete: if isAdmin();
    }

    // Покупатель отменяет свой заказ (вход через Google) до начала сборки («Принят»), один раз и с причиной
    // («Доработки 3»): заказ, который магазин отменял и вернул, отменяется через чат — его товар уже возвращали.
    // Меняются только поля отмены; оплату, состав и суммы покупатель не трогает.
    function isCustomerOrderCancel() {
      let data = request.resource.data;
      return isCustomer()
        && resource.data.get('customerUid', null) == request.auth.uid
        && resource.data.status == 'accepted'
        && resource.data.get('isCancelled', false) == false
        && !('cancelledAt' in resource.data)
        && onlyChanges(['isCancelled', 'cancelledBy', 'cancelReason', 'cancelComment', 'cancelledAt',
          'estimatedDelivery', 'stockReturned'])
        && data.isCancelled == true
        && data.cancelledBy == 'customer'
        && data.cancelReason is string && data.cancelReason.size() > 0 && data.cancelReason.size() <= 100
        && isOptionalText(data, 'cancelComment', 500)
        && data.cancelledAt is string && data.cancelledAt.size() <= 40
        && isOptionalText(data, 'estimatedDelivery', 80)
        && data.get('stockReturned', false) == false;
    }

    // «Я получил заказ» («Доработки 4»): свой заказ (вход через Google) у транспортной компании или Почты, переданный
    // перевозчику или ожидающий получения, становится «Получен»; в историю добавляется ровно одна запись покупателя,
    // прежние записи не меняются. Оплату покупатель не трогает. У старых заказов без deliveryKind кнопку решает сайт.
    function isCustomerReceiptConfirm() {
      let data = request.resource.data;
      let before = resource.data.get('statusLog', []);
      let n = before.size();
      return isCustomer()
        && resource.data.get('customerUid', null) == request.auth.uid
        && resource.data.get('isCancelled', false) == false
        && resource.data.status in ['in_transit', 'ready']
        && resource.data.get('deliveryKind', 'carrier') == 'carrier'
        && onlyChanges(['status', 'statusLog'])
        && data.status == 'delivered'
        && data.statusLog is list && data.statusLog.size() == n + 1
        && (n == 0 || data.statusLog[0:n] == before)
        && data.statusLog[n].keys().hasOnly(['status', 'at', 'by'])
        && data.statusLog[n].status == 'delivered'
        && data.statusLog[n].by == 'customer'
        && data.statusLog[n].at is string && data.statusLog[n].at.size() <= 40;
    }

    // «Оплачено» с фото чека («Доработки 5»): свой заказ (вход через Google), не отменённый, «Ожидает оплаты»
    // и с реквизитами от магазина становится «Чек на проверке». Способ — один из тех, что магазин заполнил; в историю
    // оплаты — ровно одна запись покупателя; ссылка — на его собственное сообщение в чате с фото чека к этому заказу.
    // «Оплачен» покупатель по-прежнему поставить не может.
    function isCustomerReceiptSubmit(orderId) {
      let data = request.resource.data;
      let before = resource.data.get('paymentLog', []);
      let n = before.size();
      let receipt = data.get('paymentReceipt', {});
      return isCustomer()
        && resource.data.get('customerUid', null) == request.auth.uid
        && resource.data.get('isCancelled', false) == false
        && resource.data.get('paymentStatus', 'pending') == 'pending'
        && resource.data.get('paymentDetails', null) is map
        && onlyChanges(['paymentStatus', 'paymentReceipt', 'paymentLog'])
        && data.paymentStatus == 'receipt_review'
        && receipt.keys().hasOnly(['method', 'at', 'messageId'])
        && receipt.method in ['sbp', 'card', 'account']
        && receipt.method in resource.data.paymentDetails
        && receipt.at is string && receipt.at.size() <= 40
        && receipt.messageId is string && receipt.messageId.size() <= 120
        && data.paymentLog is list && data.paymentLog.size() == n + 1
        && (n == 0 || data.paymentLog[0:n] == before)
        && data.paymentLog[n].keys().hasOnly(['event', 'at', 'by'])
        && data.paymentLog[n].event == 'receipt'
        && data.paymentLog[n].by == 'customer'
        && data.paymentLog[n].at is string && data.paymentLog[n].at.size() <= 40
        && isOwnReceiptMessage(receipt.messageId, orderId);
    }

    function isOwnReceiptMessage(messageId, orderId) {
      let message = get(/databases/$(database)/documents/chat_messages/$(messageId)).data;
      return message.threadId == request.auth.uid
        && message.sender == 'user'
        && message.get('receiptOrderId', '') == orderId
        && (message.get('imageUrl', '') != '' || message.get('imageId', '') != '');
    }

    // После возврата всех строк на склад покупатель отмечает это в своём отменённом заказе
    // (без отметки «Заказы» предлагают администратору «Вернуть на склад»)
    function isCustomerStockReturnedMark() {
      return isCustomer()
        && resource.data.get('customerUid', null) == request.auth.uid
        && resource.data.get('isCancelled', false) == true
        && resource.data.get('cancelledBy', '') == 'customer'
        && onlyChanges(['stockReturned'])
        && request.resource.data.stockReturned == true;
    }

    // ------------------------------------------------------------------
    // Чат поддержки
    // ------------------------------------------------------------------

    match /chat_messages/{messageId} {
      // У каждого покупателя свой диалог: threadId = uid (для гостей — анонимный uid).
      // Внутренние заметки сотрудников покупателю не видны.
      // Прямое обращение к полям (не .get() с умолчанием): так правило проверяется
      // по фильтрам запроса, и список без where('isInternalNote', '==', false) отклоняется.
      allow read: if isAdmin() || (
        isSignedIn()
        && resource.data.threadId == request.auth.uid
        && resource.data.isInternalNote == false
      );
      // Покупатель пишет только в свой диалог и только от себя (бота нет),
      // без внутренних заметок.
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(messageId)
        // только поля обычного сообщения: без карточек промокода/заказа и без пометок «скрыто»
        && request.resource.data.keys().hasOnly(['id', 'sender', 'text', 'imageUrl', 'imageId', 'fileName', 'timestamp',
            'threadId', 'threadName', 'isInternalNote', 'sentAt', 'receiptOrderId'])
        && request.resource.data.get('threadId', null) == request.auth.uid
        && request.resource.data.sender == 'user'
        && request.resource.data.get('isInternalNote', false) == false
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && request.resource.data.id == messageId
        // фото — только загруженное файлом (data:image), не ссылка на чужой сервер:
        // внешний адрес открылся бы у сотрудника и выдал бы его IP
        && (!('imageUrl' in request.resource.data)
          || (request.resource.data.imageUrl is string
            // ≈ 400 КБ — потолок сжатия на сайте (imageUpload.ts): картинка в 850 КБ вытесняла обращения в админке
            && request.resource.data.imageUrl.size() <= 420000
            && request.resource.data.imageUrl.matches('^data:image/(png|jpe?g|webp|gif);base64,.*')))
        // фото отдельным документом chat_images/{id сообщения} в том же пакете (этап 6, находка 20)
        && (!('imageId' in request.resource.data)
          || (request.resource.data.imageId == messageId
            && existsAfter(/databases/$(database)/documents/chat_images/$(messageId))))
        && isOptionalText(request.resource.data, 'threadName', 200)
        && isHonestName(request.resource.data.get('threadName', ''))
        && isOptionalText(request.resource.data, 'timestamp', 20)
        && isOptionalText(request.resource.data, 'fileName', 200)
        // фото чека к заказу («Доработки 5»): номер заказа — для кнопок «Подтвердить оплату» / «Отклонить чек»
        && isOptionalText(request.resource.data, 'receiptOrderId', 40)
        // без sentAt (старая версия сайта) сообщение уходит, но править его потом нельзя
        && request.resource.data.get('sentAt', request.time) == request.time
      );
      // Свое сообщение покупатель меняет (текст, «удалить у себя») и удаляет у всех
      // в течение 15 минут после отправки; время — серверное (sentAt). Сотрудники — без ограничений.
      allow update: if isAdmin() || isGuestThreadHandover() || (
        isOwnRecentChatMessage()
        && onlyChanges(['text', 'editedAt', 'hiddenForCustomer'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && request.resource.data.get('hiddenForCustomer', false) is bool
        && (!('editedAt' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.editedAt == request.time)
      );
      allow delete: if isAdmin() || isOwnRecentChatMessage();
    }

    // Переписка гостя переходит в диалог его аккаунта (находка 26): меняется только диалог сообщения, которое видит гость
    function isGuestThreadHandover() {
      return isAnonymousSelf(resource.data.threadId)
        && resource.data.isInternalNote == false
        && onlyChanges(['threadId'])
        && isLinkedAccount(request.auth.uid, request.resource.data.threadId);
    }

    // Фото сообщения чата — отдельный документ с id сообщения (этап 6, находка 20): админка больше не скачивает все фото
    // вместе с перепиской, картинка читается, когда её показывают. Доступ — как к самому сообщению: читает тот, чей
    // диалог (после переноса диалога гостя в аккаунт — новый владелец), и администратор
    match /chat_images/{imageId} {
      allow read: if isAdmin() || (isSignedIn() && isOwnVisibleMessage(get(/databases/$(database)/documents/chat_messages/$(imageId))));
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 420000
        && request.resource.data.data.matches('^data:image/(png|jpe?g|webp|gif);base64,.*')
        && isOwnVisibleMessage(getAfter(/databases/$(database)/documents/chat_messages/$(imageId)))
        && getAfter(/databases/$(database)/documents/chat_messages/$(imageId)).data.sender == 'user'
        && getAfter(/databases/$(database)/documents/chat_messages/$(imageId)).data.get('imageId', '') == imageId
      );
      // вместе с сообщением («удалить у всех»): сообщение ещё на месте, когда проверяется фото
      allow delete: if isAdmin() || (isSignedIn() && isOwnVisibleMessage(get(/databases/$(database)/documents/chat_messages/$(imageId))));
    }

    function isOwnVisibleMessage(message) {
      return message != null && message.data.threadId == request.auth.uid && message.data.isInternalNote == false;
    }

    function isOwnRecentChatMessage() {
      return isSignedIn()
        && resource.data.threadId == request.auth.uid
        && resource.data.sender == 'user'
        && resource.data.isInternalNote == false
        && request.time < resource.data.sentAt + duration.value(15, 'm');
    }

    // Состояние диалога поддержки (статус, приоритет) — рабочие пометки сотрудников,
    // покупатель их не видит
    match /support_threads/{threadId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidId(threadId);
    }

    // Статус обращения для покупателя (без приоритета): пишет администратор, читает сам покупатель
    match /support_status/{threadId} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == threadId);
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(threadId);
    }

    // ------------------------------------------------------------------
    // Профили пользователей: свой профиль или администратор
    // ------------------------------------------------------------------

    // Бонусы и заметки менеджера меняет только администратор
    function adminOnlyProfileFields() {
      return ['bonusPoints', 'managerNotes', 'tags'];
    }

    // Профиль покупателя (UserProfile в src/types.ts): только свои поля разумного размера — админка грузит профили всех;
    // почта — та, что в Google-аккаунте: по ней «Клиенты» связывали карточку, и чужая почта подменяла клиента
    // (аудит 02.10, находка 25). На изменении проверяются только изменённые поля: старые профили не ломаются
    function isOwnProfileWrite(changed) {
      let data = request.resource.data;
      return changed.hasOnly(['uid', 'name', 'lastName', 'firstName', 'middleName', 'email', 'phone', 'avatar',
          'address', 'savedAddresses', 'savedCards', 'notificationsEnabled', 'bodyMeasurements', 'updatedAt',
          'createdAt', 'lastActive'])
        && (!('email' in changed) || data.email == '' || data.email == request.auth.token.email)
        && isOptionalText(data, 'name', 200)
        && isOptionalText(data, 'lastName', 60)
        && isOptionalText(data, 'firstName', 60)
        && isOptionalText(data, 'middleName', 60)
        && isOptionalText(data, 'phone', 40)
        && isOptionalText(data, 'avatar', 2000)
        && isOptionalText(data, 'updatedAt', 40)
        && isOptionalText(data, 'createdAt', 40)
        && isOptionalText(data, 'lastActive', 40)
        && (!('address' in changed) || (data.address is map && data.address.size() <= 15))
        && (!('savedAddresses' in changed) || (data.savedAddresses is list && data.savedAddresses.size() <= 10))
        && (!('savedCards' in changed) || (data.savedCards is list && data.savedCards.size() <= 5))
        && (!('bodyMeasurements' in changed) || (data.bodyMeasurements is map && data.bodyMeasurements.size() <= 30))
        && (!('notificationsEnabled' in changed) || data.notificationsEnabled is bool);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('uid', userId) == userId
        && !request.resource.data.keys().hasAny(adminOnlyProfileFields())
        && isOwnProfileWrite(request.resource.data.keys())
      );
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('uid', userId) == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminOnlyProfileFields())
        && isOwnProfileWrite(request.resource.data.diff(resource.data).affectedKeys())
      );
      allow delete: if isAdmin();
    }

    // Заметки и теги менеджера о покупателе — только администратор
    match /customer_notes/{userId} {
      allow read, write: if isAdmin();
    }

    // Журнал склада (src/shared/stockMovements.ts): читает и ведёт администратор. Покупатель (при заказах
    // из браузера) создаёт только записи своего сохранённого заказа: id «{заказ}_{строка}», тот же товар
    // и вариант, что в строке заказа, — не больше одной записи на строку, без изменения и удаления. Списано —
    // фактически (не больше заказанного: остатка могло не хватить); ненулевая запись — только вместе со списанием
    // этого варианта в той же транзакции (аудит 02.10, находка 8). Причина и автор записи — постоянные.
    function isOrderStockMovement(movementId) {
      let data = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(data.orderId);
      let line = get(orderPath).data.items[data.lineIndex];
      let productPath = /databases/$(database)/documents/products/$(data.productId);
      return !serverOrdersEnabled()
        && data.keys().hasOnly(['id', 'createdAt', 'date', 'type', 'orderId', 'lineIndex', 'productId',
          'productTitle', 'skuCode', 'color', 'size', 'changeQuantity', 'reason', 'operator', 'skuIndex'])
        && data.type == 'order'
        && data.orderId is string && data.orderId.matches('^[A-Za-z0-9-]{1,40}$')
        && data.lineIndex is int && data.lineIndex >= 0
        && movementId == data.orderId + '_' + string(data.lineIndex)
        && data.id == movementId
        && exists(orderPath)
        && data.lineIndex < get(orderPath).data.items.size()
        && data.productId == line.product.id
        && line.get('isPreorder', false) == false
        && data.skuIndex is int && data.skuIndex >= 0
        && data.changeQuantity is int && data.changeQuantity <= 0 && data.changeQuantity >= -line.quantity
        && sameName(data.color, line.get('selectedColor', ''))
        && sameName(data.size, line.get('selectedSize', ''))
        && (data.changeQuantity == 0 || getAfter(productPath).data.get('lastStockMovement', '') == movementId)
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.date is string && data.date.size() <= 40
        && data.productTitle is string && data.productTitle.size() <= 200
        && data.skuCode is string && data.skuCode.size() <= 80
        && data.color is string && data.color.size() <= 60
        && data.size is string && data.size.size() <= 30
        && data.reason == 'Заказ #' + data.orderId
        && data.operator == 'Покупатель';
    }

    // Возврат строки отменённого покупателем заказа (returnOrderLineStock, «Доработки 3»): id «{заказ}_{строка}_return»,
    // один на строку, ровно столько, сколько списала запись «{заказ}_{строка}», и только вместе с возвратом этого
    // варианта в той же транзакции. Заказ — свой и отменён самим покупателем; причина и автор — постоянные.
    function isOrderStockReturnMovement(movementId) {
      let data = request.resource.data;
      let order = get(/databases/$(database)/documents/orders/$(data.orderId)).data;
      let line = order.items[data.lineIndex];
      let takenPath = /databases/$(database)/documents/stock_movements/$(data.orderId + '_' + string(data.lineIndex));
      let productPath = /databases/$(database)/documents/products/$(data.productId);
      return isCustomer()
        && data.keys().hasOnly(['id', 'createdAt', 'date', 'type', 'orderId', 'lineIndex', 'productId',
          'productTitle', 'skuCode', 'color', 'size', 'changeQuantity', 'reason', 'operator', 'skuIndex'])
        && data.type == 'return'
        && data.orderId is string && data.orderId.matches('^[A-Za-z0-9-]{1,40}$')
        && data.lineIndex is int && data.lineIndex >= 0 && data.lineIndex < order.items.size()
        && movementId == data.orderId + '_' + string(data.lineIndex) + '_return'
        && data.id == movementId
        && order.get('customerUid', null) == request.auth.uid
        && order.get('isCancelled', false) == true
        && order.get('cancelledBy', '') == 'customer'
        && exists(takenPath)
        && data.productId == get(takenPath).data.productId
        && data.productId == line.product.id
        && data.changeQuantity is int && data.changeQuantity > 0
        && data.changeQuantity == -get(takenPath).data.changeQuantity
        && data.skuIndex is int && data.skuIndex >= 0
        && sameName(data.color, line.get('selectedColor', ''))
        && sameName(data.size, line.get('selectedSize', ''))
        && getAfter(productPath).data.get('lastStockMovement', '') == movementId
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.date is string && data.date.size() <= 40
        && data.productTitle is string && data.productTitle.size() <= 200
        && data.skuCode is string && data.skuCode.size() <= 80
        && data.reason == 'Отмена заказа #' + data.orderId
        && data.operator == 'Покупатель';
    }

    match /stock_movements/{movementId} {
      // Покупатель читает записи своего заказа по одной — чтобы вернуть на склад ровно списанное; несуществующую
      // запись тоже (так он узнаёт, что строку уже вернули). Списком журнал читает только администратор.
      allow get: if isAdmin() || (isCustomer() && (resource == null
        || get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.get('customerUid', null)
          == request.auth.uid));
      allow list: if isAdmin();
      allow create: if isAdmin() || isOrderStockMovement(movementId) || isOrderStockReturnMovement(movementId);
      allow update, delete: if isAdmin() && isValidId(movementId);
    }

    // ------------------------------------------------------------------
    // Реестр администраторов: только чтение своей записи.
    // Добавлять администраторов — вручную через Firebase Console.
    // ------------------------------------------------------------------

    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    // ------------------------------------------------------------------
    // Журнал ошибок у покупателей (docs/ops-plan.md, этап 2, src/utils/errorReporter.ts): отчёт создаёт любой
    // посетитель — он может быть и не вошедшим. Ограничить по покупателю нельзя (анонимных входов посторонний заведёт
    // сколько угодно), поэтому ограничено на весь сайт: id — «{час}_{ячейка}» с часом по часам сервера (±1 на
    // неточные часы телефона) и ячейкой 0–29, перезаписи нет — не больше 30 отчётов в час и ≈ 3 КБ на отчёт.
    // Читает и удаляет только администратор («Аналитика» → «Ошибки на сайте»). В резервную копию журнал не входит.
    // ------------------------------------------------------------------

    match /client_errors/{errorId} {
      allow read, delete: if isAdmin();
      allow create: if isClientErrorReport(errorId);
    }

    function isClientErrorReport(errorId) {
      let parts = errorId.split('_');
      let hour = math.floor(request.time.toMillis() / 3600000);
      let data = request.resource.data;
      return parts.size() == 2
        && parts[0].matches('^[0-9]{6,8}$') && parts[1].matches('^[0-9]{1,2}$')
        && int(parts[0]) >= hour - 1 && int(parts[0]) <= hour + 1
        && int(parts[1]) < 30
        && data.keys().hasAll(['kind', 'message', 'page', 'createdAt'])
        && data.keys().hasOnly(['kind', 'message', 'stack', 'page', 'release', 'browser', 'createdAt'])
        && data.kind in ['error', 'rejection', 'render', 'console', 'update']
        && data.message is string && data.message.size() > 0 && data.message.size() <= 500
        && data.get('stack', '') is string && data.get('stack', '').size() <= 2000
        && data.page is string && data.page.size() <= 200
        && data.get('release', '') is string && data.get('release', '').size() <= 40
        && data.get('browser', '') is string && data.get('browser', '').size() <= 300
        && data.createdAt == request.time;
    }

    // Проверка соединения при старте приложения (только чтение)
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
