rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Администратор: верифицированный Google-аккаунт владельца
    // или пользователь, для которого вручную создан документ /admins/{uid}
    // (создаётся только через Firebase Console / Admin SDK).
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'gunh83975@gmail.com'
          && request.auth.token.email_verified == true)
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Изменены только перечисленные поля существующего документа
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // settings/server.serverOrdersEnabled: заказы оформляет Cloud Function placeOrder
    // (Admin SDK, правила не применяются). Клиентам запрещено создавать заказы,
    // списывать остатки и менять счётчики промокодов напрямую.
    function serverOrdersEnabled() {
      let path = /databases/$(database)/documents/settings/server;
      return exists(path) && get(path).data.get('serverOrdersEnabled', false) == true;
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Каталог и витрина: читают все, меняет только администратор
    // ------------------------------------------------------------------

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin() && isValidId(productId);
      // Покупатели могут оставлять отзывы, а пока заказы не оформляются на сервере —
      // ещё и списывать остатки. Остальные поля — только администратор.
      allow update: if isAdmin()
        || onlyChanges(['reviews', 'rating', 'reviewsCount'])
        || (!serverOrdersEnabled()
          && onlyChanges(['skus', 'inStock', 'reviews', 'rating', 'reviewsCount']));
    }

    match /promos/{promoId} {
      allow read: if true;
      allow create, delete: if isAdmin() && isValidId(promoId);
      // Покупатели могут обновлять только счётчики использования промокода
      // (и только пока заказы не оформляются на сервере)
      allow update: if isAdmin()
        || (!serverOrdersEnabled()
          && onlyChanges(['usedCount', 'generatedRevenue', 'commissionEarned'])
          && request.resource.data.get('usedCount', 0) >= resource.data.get('usedCount', 0));
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(bannerId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    match /delivery_methods/{methodId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(methodId);
    }

    match /pickup_points/{pointId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(pointId);
    }

    // ------------------------------------------------------------------
    // Заказы: оформить может любой (включая гостей), читать —
    // владелец (по customerUid) или администратор, менять — администратор
    // ------------------------------------------------------------------

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerUid == request.auth.uid);

      allow create: if isAdmin() || (
        !serverOrdersEnabled()
        && isValidId(orderId)
        && request.resource.data.id == orderId
        && request.resource.data.status == 'accepted'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice >= 0
        && request.resource.data.get('isCancelled', false) == false
        && request.resource.data.get('paymentStatus', 'pending') in ['pending', 'paid', 'paid_on_delivery']
        // Гость не указывает customerUid, авторизованный — только свой
        && (request.resource.data.get('customerUid', null) == null
          || (isSignedIn() && request.resource.data.customerUid == request.auth.uid))
      );

      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Чат поддержки
    // ------------------------------------------------------------------

    match /chat_messages/{messageId} {
      // У каждого покупателя свой диалог: threadId = uid (для гостей — анонимный uid).
      // Внутренние заметки сотрудников покупателю не видны.
      // Прямое обращение к полям (не .get() с умолчанием): так правило проверяется
      // по фильтрам запроса, и список без where('isInternalNote', '==', false) отклоняется.
      allow read: if isAdmin() || (
        isSignedIn()
        && resource.data.threadId == request.auth.uid
        && resource.data.isInternalNote == false
      );
      // Покупатель пишет только в свой диалог, только от себя (и ответы бота),
      // без внутренних заметок.
      allow create: if isAdmin() || (
        isSignedIn()
        && isValidId(messageId)
        && request.resource.data.get('threadId', null) == request.auth.uid
        && request.resource.data.sender in ['user', 'bot']
        && request.resource.data.get('isInternalNote', false) == false
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
      );
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Профили пользователей: свой профиль или администратор
    // ------------------------------------------------------------------

    // Бонусы и заметки менеджера меняет только администратор
    function adminOnlyProfileFields() {
      return ['bonusPoints', 'managerNotes', 'tags'];
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('uid', userId) == userId
        && !request.resource.data.keys().hasAny(adminOnlyProfileFields())
      );
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('uid', userId) == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminOnlyProfileFields())
      );
      allow delete: if isAdmin();
    }

    // Заметки и теги менеджера о покупателе — только администратор
    match /customer_notes/{userId} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Реестр администраторов: только чтение своей записи.
    // Добавлять администраторов — вручную через Firebase Console.
    // ------------------------------------------------------------------

    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    // Проверка соединения при старте приложения (только чтение)
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
