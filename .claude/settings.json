{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(bun run deploy *)",
      "Bash(firebase deploy *)",
      "Bash(bunx firebase deploy *)",
      "Bash(npx firebase deploy *)",
      "Bash(firebase firestore:delete *)",
      "Bash(bunx firebase firestore:delete *)",
      "Bash(npx firebase firestore:delete *)",
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__actions_run_trigger",
      "mcp__github__delete_file"
    ],
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run build)",
      "Bash(bun run test:*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-install.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-before-stop.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
