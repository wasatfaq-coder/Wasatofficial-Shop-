{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ECC_SKIP_LLM_SUMMARY": "1",
    "ECC_DISABLED_HOOKS": "pre:edit-write:gateguard-fact-force,pre:bash:gateguard-fact-force,pre:powershell:gateguard-fact-force"
  },
  "permissions": {
    "ask": [
      "Bash(bun run deploy *)",
      "Bash(firebase deploy *)",
      "Bash(bunx firebase deploy *)",
      "Bash(npx firebase deploy *)",
      "Bash(firebase firestore:delete *)",
      "Bash(bunx firebase firestore:delete *)",
      "Bash(npx firebase firestore:delete *)",
      "Bash(gh pr merge *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-install.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ecc-install.sh",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "github",
        "repo": "affaan-m/ECC",
        "ref": "v2.2.3"
      }
    }
  }
}
